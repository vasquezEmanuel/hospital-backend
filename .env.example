# Copiar a .env (NUNCA subir .env al repositorio)
ENVIRONMENT=local
DOCS_ENABLED=true
# Puerto de PostgreSQL en tu PC (docker compose lo lee de este archivo). Si el 5432 está ocupado, usa 5433 aquí
# y el mismo puerto en DATABASE_URL.
DB_PORT=5432
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/hospital

# Proveedor de identidad (OIDC). Con JWKS (claves asimétricas) o con secreto HS256 (solo desarrollo local).
# Supabase Auth: AUTH_ISSUER=https://REF.supabase.co/auth/v1 · AUTH_AUDIENCE=authenticated
#                AUTH_JWKS_URL=https://REF.supabase.co/auth/v1/.well-known/jwks.json · AUTH_ALGORITHMS=ES256
AUTH_ISSUER=
AUTH_AUDIENCE=
AUTH_JWKS_URL=
AUTH_JWT_SECRET=
AUTH_ALGORITHMS=RS256,ES256,HS256
# Dónde vienen los roles en el token: "groups" (Cognito) | "app_metadata.roles" (Supabase) | claim propio (Auth0)
AUTH_ROLES_CLAIM=groups
# true: solo entran tokens con segundo factor verificado (aal2). Obligatorio en producción.
AUTH_REQUIRE_MFA=false
# Opcional (Sprint 5): usuario propietario para las migraciones al arrancar; DATABASE_URL queda para el usuario
# restringido hospital_api. Si no se define, las migraciones usan DATABASE_URL.
# MIGRATIONS_DATABASE_URL=
CORS_ORIGINS=http://localhost:5173